# Base URL ของ backend FastAPI (copy เป็น .env.local)
# พอร์ต 8500 — :8000 เป็นของ d_CEO ที่รันค้างตลอด ห้ามชน (ดู docs/runbook.md §1)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8500

# ต้องตรงกับ API_TOKEN ใน backend/.env — ว่าง = backend ไม่ได้ล็อก (dev บน localhost)
# ⚠️ ค่านี้ถูกฝังลง bundle ที่ browser โหลดได้ **ไม่ใช่ความลับจากคนที่ใช้เครื่องนี้**
# หน้าที่ของมันคือกันคนนอกที่ยิงเข้าพอร์ตตรง ๆ (ดู docs/SECURITY.md)
NEXT_PUBLIC_API_TOKEN=
